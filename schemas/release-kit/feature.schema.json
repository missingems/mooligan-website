{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mooligan.com/schemas/release-kit/feature.schema.json",
  "title": "Release kit: front matter of features/<feature>.md",
  "description": "One feature of the app: what it is, its use cases and the flow of each. See docs/release-kit.md.",
  "type": "object",
  "required": ["id", "title", "summary", "since", "use_cases"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/definitions/id" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "since": { "$ref": "#/definitions/version" },
    "ui": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "use_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "flow"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "type": "string", "minLength": 1 },
          "goal": { "type": "string" },
          "flow": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["step"],
              "additionalProperties": false,
              "properties": {
                "step": { "type": "string", "minLength": 1 },
                "capture": { "$ref": "#/definitions/id" }
              }
            }
          },
          "video": { "$ref": "#/definitions/id" },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" }
  }
}
